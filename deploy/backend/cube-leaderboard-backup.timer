# Installed to /etc/systemd/system/ by deploy/backend/deploy-backend.sh.
[Unit]
Description=Daily cube.micutu.com leaderboard backup

[Timer]
# Just after yesterday's challenge becomes final (01:00 UTC, see
# backend/src/cube_leaderboard/web.gleam), so each snapshot holds a
# finished day.
OnCalendar=*-*-* 01:20:00 UTC
RandomizedDelaySec=10m
Persistent=true
Unit=cube-leaderboard-backup.service

[Install]
WantedBy=timers.target
